<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h1>Chat app</h1>
    <input id="ip_username" type="text" placeholder="Nhập tên" />
    <br />
    <br />
    <input id="ip_room" type="text" placeholder="Nhập Room" />
    <br />
    <br />
    <button id="btn_send_room">Gửi</button>

    <br />
    <br />
    <input type="text" placeholder="messages..." id="ip_message" />
    <button id="btn_send_message">Gửi</button>

    <ul id="thread"></ul>
  </body>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    let socket = io.connect('localhost:5000');

    let ip_username = document.getElementById('ip_username');
    let ip_room = document.getElementById('ip_room');
    let btn_send_room = document.getElementById('btn_send_room');
    let ip_message = document.getElementById('ip_message');
    let btn_send_message = document.getElementById('btn_send_message');
    let ulthread = document.getElementById("thread");

    btn_send_room.addEventListener('click', () => {
      socket.emit('join', ip_room.value);
    });

    btn_send_message.addEventListener('click', () => {
        socket.emit("messages", `${ip_username.value}: ${ip_message.value}`);
        ip_message.reset();
    })

    socket.on('thread', function(data){
        let li = document.createElement("li");
        li.innerHTML = data;
        ulthread.appendChild(li);
    })
  </script>
</html>
